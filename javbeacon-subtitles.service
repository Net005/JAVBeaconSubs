[Unit]
Description=JAVBeacon subtitle generation service
After=network.target

[Service]
Type=simple
User=javbeacon
Group=javbeacon
WorkingDirectory=/opt/javbeaconsubs
ExecStart=/opt/javbeaconsubs/javbeaconsubs -config /etc/javbeaconsubs/config.json
EnvironmentFile=-/etc/javbeaconsubs/environment
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/media /var/lib/javbeaconsubs

[Install]
WantedBy=multi-user.target
