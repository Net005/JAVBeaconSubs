{
  "listen": "127.0.0.1:8097",
  "api_token": "",
	"web_username": "",
	"web_password": "",
	"database_path": "./data/javbeaconsubs.db",
	"upload_dir": "./data/uploads",
	"max_upload_gb": 30,
  "workers": 1,
  "whisper": {
    "binary": "/opt/whisper.cpp/build/bin/whisper-cli",
    "model": "/opt/whisper.cpp/models/ggml-large-v3.bin",
    "vad_model": "/opt/whisper.cpp/models/ggml-silero-v6.2.0.bin",
    "language": "ja",
    "threads": 8,
    "use_gpu": true,
    "beam_size": 5,
    "vad": true,
    "vad_threshold": 0.42,
    "vad_min_speech_ms": 100,
    "vad_min_silence_ms": 250,
    "vad_speech_pad_ms": 320,
		"gpu_preflight": true,
		"gpu_auto_reset": false,
		"gpu_fallback_cpu": true,
    "prompt": "日本語の会話です。固有名詞、呼び名、短い返事、息遣いも正確に文字起こししてください。"
  },
  "translation": {
    "mode": "direct",
    "base_url": "http://127.0.0.1:11434/v1",
    "api_key": "",
    "model": "qwen3:14b",
    "batch_size": 24,
    "timeout_seconds": 120,
		"context_gap_ms": 8000,
		"translation_memory": false,
		"glossary": "",
		"structured_glossary": {
			"style": [],
			"terms": {}
		}
  },
	"post_processing": {
		"mode": "none",
		"shell_script": "",
		"webhook_url": "",
		"webhook_bearer_token": "",
		"timeout_seconds": 60
	},
  "output": {
    "english_suffix": ".en.srt",
    "japanese_suffix": ".ja.srt",
    "keep_japanese": true,
    "overwrite": false,
    "max_line_chars": 42,
    "max_lines": 2
  }
}
