# Host and container port used by both the web/API listener and health check.
SUBTITLE_PORT=8097

# Host directories persisted into the container. Relative paths resolve from compose.yaml.
JAVBEACONSUBS_DATA_PATH=./data
JAVBEACONSUBS_MODELS_PATH=./models
JAVBEACONSUBS_SCRIPTS_PATH=./scripts

# Host media directory shared with JAVBeacon; generated subtitles are written here.
MEDIA_PATH=./media

# Numeric owner used for generated SRT files, uploads, and SQLite data. PGID is
# preferred; GID and GUID are accepted as compatibility aliases. The selected
# user/group must have write access to every host media directory you mount.
PUID=1000
PGID=1000
GID=
GUID=
UMASK=0002

# Secret for JAVBeacon and other external API clients. It is not used by the web
# login. Send it as `Authorization: Bearer <token>` or `X-API-Key: <token>`.
# Generate one with: openssl rand -hex 32
JAVBEACONSUBS_API_TOKEN=

# The web interface creates its username/password interactively on first launch and
# stores the salted password hash in SQLite. These optional values seed that first
# account for unattended deployments; remove them after the account has been created.
JAVBEACONSUBS_WEB_USERNAME=
JAVBEACONSUBS_WEB_PASSWORD=

# Optional Bearer credential sent only to the configured OpenAI-compatible contextual
# translation endpoint. It is unrelated to the API token above. Leave blank for direct
# Whisper translation or local endpoints such as Ollama that do not require a key.
JAVBEACONSUBS_TRANSLATION_API_KEY=

# Japanese ASR pipeline. Qwen is primary and Japanese is forced. Balanced mode
# retries suspicious Qwen text once, then verifies unresolved lexical speech with Whisper.
JAVBEACONSUBS_ASR_BACKEND=qwen
JAVBEACONSUBS_ASR_MODE=balanced
JAVBEACONSUBS_ASR_PROFILE=jav
JAVBEACONSUBS_QWEN_MODEL=Qwen/Qwen3-ASR-1.7B
JAVBEACONSUBS_QWEN_REVISION=7278e1e70fe206f11671096ffdd38061171dd6e5
JAVBEACONSUBS_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
JAVBEACONSUBS_ALIGNER_REVISION=c7cbfc2048c462b0d63a45797104fc9db3ad62b7
JAVBEACONSUBS_REAZON_ENABLED=false
JAVBEACONSUBS_WHISPER_ENABLED=true
# Any whisper.cpp-compatible multilingual model may be selected independently.
# Quantized variants are optional; keep Large-v3 unless you have benchmarked one.
JAVBEACONSUBS_WHISPER_MODEL=/models/ggml-large-v3.bin
JAVBEACONSUBS_WHISPER_DEVICE=auto
JAVBEACONSUBS_WHISPER_CPU_TIMEOUT_SECONDS=7200
# 12 was fastest/stablest in the 4/8/12/16 short CPU benchmark on 16 logical CPUs.
JAVBEACONSUBS_WHISPER_THREADS=12
JAVBEACONSUBS_WHISPER_BEAM_SIZE=5
JAVBEACONSUBS_WHISPER_BEST_OF=5
# Full Large-v3 succeeded with 5 GB free; below 4 GB skip the known-risk CUDA attempt.
JAVBEACONSUBS_WHISPER_CUDA_SAFE_MINIMUM_MB=4096
JAVBEACONSUBS_WHISPER_RUNTIME_STATUS_PATH=/data/whisper-runtime.json
JAVBEACONSUBS_REAZON_MODEL=reazon-research/reazonspeech-nemo-v2
# Set REAZON_ENABLED=true only to pre-cache experimental/standalone Reazon support.
# Bundled, independently validated recognition and translation catalogs.
JAVBEACONSUBS_RECOGNITION_VOCABULARY=/app/vocabulary/javbeaconsubs_japanese_recognition_vocabulary_v1.json
JAVBEACONSUBS_TRANSLATION_GLOSSARY=/app/javbeaconsubs_translation_glossary_v2.json

# Download pinned Whisper/VAD models when they are absent from the model cache.
JAVBEACONSUBS_DOWNLOAD_MODELS=true

# CPU fallback retries the complete selective Whisper batch once when CUDA
# initialization or allocation fails. Large-v3 can be slow on CPU.
JAVBEACONSUBS_GPU_FALLBACK_CPU=true

# GPU reset is normally unavailable for a display/primary GPU. Leave disabled;
# enable only on a dedicated compute GPU that is safe to reset.
JAVBEACONSUBS_GPU_AUTO_RESET=false
NVIDIA_GPU_DEVICE_ID=0

# Pinned whisper.cpp and ReazonSpeech source revisions used by the image build.
WHISPER_CPP_REF=f049fff95a089aa9969deb009cdd4892b3e74916
REAZONSPEECH_REF=8be654dc9ba8d205759d9d93fe717ae37f321b01

# CUDA build targets and build parallelism. Defaults cover common NVIDIA
# generations while keeping GitHub-hosted package builds within memory limits.
CUDA_ARCHITECTURES=75;86
WHISPER_BUILD_JOBS=2

# Existing external Docker network used by compose.javbeacon.yaml.
JAVBEACON_NETWORK=javbeacon_default
